# ============================
# ScholarMind 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================

# ---------- API 密钥 (必填) ----------
# DashScope / OpenAI 兼容 API Key
# 同时用于 LLM、Embedding、Reranker
OPENAI_API_KEY=sk-your-key-here

# API Base URL (DashScope 或其他兼容端点)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- LLM 模型 ----------
# 快速模型 (Planner, Writer, Refiner, Router)
FAST_LLM_MODEL=qwen3-max

# 严谨模型 (Researcher, Reviewer)
SMART_LLM_MODEL=deepseek-r1

# ---------- 网络搜索 ----------
# Tavily Search API Key
TAVILY_API_KEY=tvly-your-key-here

# ---------- Elasticsearch ----------
ES_URL=http://localhost:9200
ES_INDEX=scholarmind_knowledge_base
# ES_USER=
# ES_PASSWORD=

# ---------- Embedding ----------
# dashscope (阿里云) 或 huggingface (本地)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4

# ---------- Reranker ----------
RERANKER_MODEL=qwen3-rerank
RERANKER_TOP_N=30
# RERANKER_DEBUG=1   # 开启调试日志

# ---------- 评测 (可选) ----------
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_JUDGE_MODEL=deepseek-chat
# SCHOLARMIND_EVAL_PDF=/path/to/eval-paper.pdf
